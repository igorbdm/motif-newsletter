YOUTUBE_API_KEY=sua-chave-da-api-do-youtube

# Provedor de envio: "kit" (padrão em produção) ou "smtp"
EMAIL_DELIVERY_PROVIDER=smtp

# --- Configuração SMTP (usada quando EMAIL_DELIVERY_PROVIDER=smtp) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@example.com
SMTP_PASSWORD=sua-senha-ou-senha-de-aplicativo
EMAIL_FROM=seu-email@example.com
EMAIL_TO=seu-email@example.com

# --- Configuração Kit (usada quando EMAIL_DELIVERY_PROVIDER=kit) ---
KIT_API_KEY=sua-chave-v4
KIT_TAG_NAME=music-weekly
KIT_SENDER_EMAIL=newsletter@motifnewsletter.com
KIT_PUBLISH_TO_WEB=false
KIT_SEND_DELAY_MINUTES=1
